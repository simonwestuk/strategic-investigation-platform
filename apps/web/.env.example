# Base URL of the FastAPI backend (inlined at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Serve the bundled JSON fixtures instead of calling the backend.
NEXT_PUBLIC_USE_FIXTURES=false

# One person directs the agents and holds every approval (default). Set to true to split approvals by role.
NEXT_PUBLIC_TEAM_MODE=false
NEXT_PUBLIC_OPERATOR_NAME=Operator
