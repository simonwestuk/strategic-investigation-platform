# Azure OpenAI / Foundry v1 endpoint
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_MODEL=YOUR_DEPLOYMENT_NAME
# Prefer Entra ID in deployed environments. API key is optional for local development.
AZURE_OPENAI_API_KEY=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=strategic-investigation-platform
