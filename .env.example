# Copy to .env. Every variable is optional: the defaults run a fully offline demo with no credentials.
# Authoritative list and defaults: src/sip/config.py

# --- Runtime ---------------------------------------------------------------------------------------
SIP_ENV=local                      # local | test | staging | production
SIP_REASONER=offline               # offline (deterministic, no model) | llm (Azure OpenAI / Foundry)
SIP_SEARCH_PROVIDER=offline_corpus # offline_corpus (synthetic, per scenario) | tavily | brave
SIP_LOG_LEVEL=INFO
SIP_LOG_JSON=false

# --- Persistence -----------------------------------------------------------------------------------
# SQLite works for a single local process. Use PostgreSQL for anything shared (docker compose sets this).
DATABASE_URL=sqlite+aiosqlite:///./var/sip.db
# The pseudonym vault MUST be a separate database/connection from the application database.
VAULT_DATABASE_URL=sqlite+aiosqlite:///./var/vault.db
# Encrypts real values in the vault. Change it for any shared environment; Key Vault in Azure.
SIP_VAULT_KEY=
# Optional: private Azure Blob container URL for raw uploads (otherwise ./var/quarantine).
SIP_QUARANTINE_BLOB_URL=

# --- Model provider (Azure OpenAI / Microsoft Foundry, OpenAI-compatible v1 endpoint) --------------
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_OPENAI_AUTH=entra_id         # entra_id (DefaultAzureCredential, recommended) | api_key
AZURE_OPENAI_API_KEY=
SIP_LLM_API=responses              # responses | chat_completions
SIP_MODEL_REASONING=gpt-5.1        # deployment name used for framing, planning, analysis, challenge, synthesis
SIP_MODEL_EXTRACTION=gpt-5-mini    # deployment name used for evidence extraction
SIP_LLM_REASONING_EFFORT=medium
SIP_LLM_TIMEOUT_S=90
SIP_LLM_MAX_RETRIES=3
SIP_MODEL_PRICES=gpt-5.1=1.25:10;gpt-5-mini=0.25:2   # USD per 1M tokens (in:out), for cost telemetry only

# --- Live web research -----------------------------------------------------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SIP_FETCH_TIMEOUT_S=15
SIP_FETCH_MAX_BYTES=3000000

# --- Privacy gateway -------------------------------------------------------------------------------
SIP_PII_DETECTOR=local             # local | azure_language
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_KEY=            # leave empty to use Entra ID
SIP_UPLOAD_MAX_BYTES=10000000

# --- Observability ---------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=strategic-investigation-platform
SIP_TRACE_CONTENT=redacted         # full | redacted | metadata_only
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Auth ------------------------------------------------------------------------------------------
SIP_AUTH_MODE=dev                  # dev (trusted headers; refused in production) | entra_id
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
SIP_CORS_ORIGINS=http://localhost:3000

# --- Default research budget per investigation -----------------------------------------------------
SIP_BUDGET_MAX_ITERATIONS=4
SIP_BUDGET_MAX_TASKS=48
SIP_BUDGET_MAX_SEARCHES=40
SIP_BUDGET_MAX_FETCHES=80
SIP_BUDGET_MAX_LLM_CALLS=250
SIP_BUDGET_MAX_COST_USD=5.0
